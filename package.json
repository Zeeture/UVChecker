{
  "name": "uv-checker-generator",
  "version": "1.0.0",
  "description": "Standalone Windows UV checker texture generator",
  "main": "main.js",
  "author": "UV Checker Generator",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.uvchecker.generator",
    "productName": "UV Checker Generator",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "UV-Checker-Generator-${version}-portable.${ext}"
    }
  }
}